PORT=3000

# options: us-west-2 | us-east-1 | eu-central-1 | ap-northeast-1
RECALL_REGION=us-west-2

RECALL_API_KEY=
RECALL_WEBHOOK_VERIFICATION_SECRET=
DATABASE_PATH=./data/scribe.db
RECORD_VIDEO=true     # default for new visits, can be changed in the UI

# Clinical note generation

# options: anthropic | openai
AI_PROVIDER=

AI_MODEL=            # optional
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# options: soap | dap | birp
NOTE_FORMAT=soap

# ---------------------------------------------------------------------------
# Calendar V2 (optional)
#
# Leave these blank to run without the calendar integration. Configure a
# provider and the app can schedule bots straight from a clinician's calendar.
# ---------------------------------------------------------------------------

# Your public base URL — the same ngrok domain you gave the Recall webhook.
# OAuth redirect URIs are derived from it, so it must match what you registered
# with Google and Microsoft.
PUBLIC_URL=

# Google Calendar. Redirect URI to register:
#   $PUBLIC_URL/calendar/callback/google
# https://docs.recall.ai/docs/calendar-v2-google-calendar
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Microsoft Outlook. Redirect URI to register:
#   $PUBLIC_URL/calendar/callback/microsoft
# https://docs.recall.ai/docs/calendar-v2-microsoft-outlook
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=

# Microsoft can authenticate with a certificate instead of a client secret.
# Certificates are recommended: a client secret expires within 24 months, and
# when it does every connected Outlook calendar disconnects. Leave
# MICROSOFT_OAUTH_CLIENT_SECRET blank to use the certificate.
MICROSOFT_OAUTH_CERTIFICATE_PATH=
MICROSOFT_OAUTH_PRIVATE_KEY_PATH=
